{
    "name": "cerealconcept/cereal-images",
    "description": "Génère des versions AVIF et WebP des images et les sert via .htaccess.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-gd": "*"
    },
    "require-dev": {
        "carthage-software/mago": "^1.0",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-cli/php-cli-tools": "^0.13.2"
    },
    "autoload-dev": {
        "psr-4": {
            "CerealImages\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "carthage-software/mago": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "format": "mago format --check",
        "format:fix": "mago format",
        "lint": "mago lint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@format",
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
